#include <windows.h>

1 ICON "assets/branding/winrisef-toolbox-agent.ico"
1 RT_MANIFEST "assets/windows/winrisef-toolbox-agent.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,1
 PRODUCTVERSION 0,1,0,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x2L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "WinriseF\0"
            VALUE "FileDescription", "WinriseF Toolbox Agent\0"
            VALUE "FileVersion", "0.1.0 Beta 1\0"
            VALUE "InternalName", "winrisef-agent\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 WinriseF\0"
            VALUE "OriginalFilename", "WinriseF-Toolbox-Agent.exe\0"
            VALUE "ProductName", "WinriseF Toolbox\0"
            VALUE "ProductVersion", "0.1.0 Beta 1\0"
            VALUE "Comments", "Provides local file, device, and LAN capabilities for WinriseF Toolbox.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
